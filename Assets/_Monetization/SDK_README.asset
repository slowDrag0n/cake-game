%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c398eab9b65b4c94298ddc0f746fc0f3, type: 3}
  m_Name: SDK_README
  m_EditorClassIdentifier: 
  maintainer: SexyDevs (SexyDevs.Utils namespace)
  lastUpdated: June 29, 2026
  setup: '1. Set Ad Provider dropdown on MediationAdsManager

    2. Fill in ID fields
    for that scenario (others are hidden)

    3. Hit Play'
  scenarios: "AdMobOnly            \u2014 AdMob handles everything incl. App Open\nAppLovinOnly        
    \u2014 AppLovin MAX handles everything incl. App Open\nAppLovinWithAdMobAOA \u2014
    MAX for Banner/Inter/Rewarded, AdMob for App Open\n\nTo enable AppLovin: import
    MAX plugin \u2192 add MAX_SDK scripting define symbol"
  adsAPI: "// Interstitials \u2014 gated by timer when Use Ad Timer is on\nMediationAdsManager.Instance.ShowInterstitial(state
    => { });\nMediationAdsManager.Instance.ShowStaticInterstitial(state => { });\n\n//
    Rewarded \u2014 never gated\nMediationAdsManager.Instance.ShowRewarded(state
    => { });\n\n// Banner / MREC\nMediationAdsManager.Instance.ShowBanner();\nMediationAdsManager.Instance.HideBanner();\nMediationAdsManager.Instance.ShowMrec();\nMediationAdsManager.Instance.HideMrec();\n\n//
    App Open \u2014 call on foreground/focus\nAppOpenAdManager.Instance.ShowAdIfReady();\nAppOpenAdManager.Instance.canShowAD
    = false; // gate during gameplay"
  iapAPI: 'InappManager.Instance.Purchase_product("product_id");

    InappManager.Instance.IsProductOwned("product_id");      
    // bool

    InappManager.Instance.IsSubscriptionActive("product_id"); // bool


    //
    Products configured in InappManager Inspector via InappManagerEditor'
  analyticsAPI: 'FbaManager.Instance.SendCustomEvent("event_name");

    FbaManager.Instance.GetRemoteConfigValue<float>(FbaManager.RemoteConfigKeys.AdsInterval);

    FbaManager.Instance.IsRemoteConfigReady;
    // bool

    // Firebase Analytics + Remote Config. Initialized automatically
    on startup.'
  adTimer: "Toggle 'Use Ad Timer' on MediationAdsManager to enable interval gating.\n\nFirstAdInterval 
    (first_ad_interval, default 60s)\n  Session-start gate. No interstitial fires
    until this expires.\n  Fires MonetizationEvents.OnFirstAdIntervalCompleted when
    done.\n\nAdsInterval  (ad_interval, default 30s)\n  Between-ad cooldown. Resets
    on every full-screen ad close.\n  ShowInterstitial() blocks silently while counting
    \u2014 no extra checks needed."
  gameEvents: "GameEvents \u2014 YOUR GAME fires these:\n\nGameEvents.OnLevelStart?.Invoke();\nGameEvents.OnLevelComplete?.Invoke();\nGameEvents.OnLevelFailed?.Invoke();\nGameEvents.OnLevelRestart?.Invoke();\nGameEvents.OnLevelSpawned?.Invoke();\nGameEvents.OnNotEnoughResources?.Invoke(\"message\");\nGameEvents.OnAdsRemoved?.Invoke();"
  monetizationEvents: "MonetizationEvents \u2014 SDK fires these, YOUR GAME subscribes:\n\nMonetizationEvents.OnRemoteConfigUpdated     
    // Remote Config ready\nMonetizationEvents.OnFirstAdIntervalCompleted // interstitials
    unlocked\nMonetizationEvents.OnAdTimerReset             // any full-screen ad
    closed\nMonetizationEvents.OnIAPInit                  // IAP store ready\nMonetizationEvents.OnIAPPurchased            
    // purchase completed\nMonetizationEvents.OnRemoveAdsPurchased       // remove
    ads granted\n\nExample:\nMonetizationEvents.OnFirstAdIntervalCompleted += EnableAdButton;"
  adState: "AdState.Opening   \u2014 ad is on screen\nAdState.Reward    \u2014 reward
    earned (rewarded only)\nAdState.Closed    \u2014 user dismissed\nAdState.Failed   
    \u2014 show or load failed\nAdState.Canceled  \u2014 timed out or blocked by
    timer\nAdState.Loaded    \u2014 informational\n\nExample: MediationAdsManager.Instance.ShowRewarded(state
    => {\n    if (state == AdState.Reward) GiveReward();\n});"
  monetizationData: "Static PlayerPrefs wrappers \u2014 access anywhere without a
    reference:\n\nMonetizationData.RemoveAds              // bool\nMonetizationData.RemoveAdsPurchased    
    // bool\nMonetizationData.SubscriptionPurchased  // bool\nMonetizationData.CurrentLevel          
    // int\nMonetizationData.SessionCounter         // int\nMonetizationData.Currency              
    // int"
  remoteConfigKeys: 'ad_interval           float  30s   Between-ad cooldown

    first_ad_interval    
    float  60s   Session-start gate

    inter_ad_show         bool   true  Whether
    to show interstitials

    inter_ad_trigger      bool   true  Trigger condition

    inter_ad_type        
    bool   false Which type to show

    Inter_ad_start        int    1     Level
    to start ads

    afk_interval          float  15s   Gameplay idle interval

    app_open_ad          
    bool   true  AOA enabled

    app_open_ses          bool   false AOA per session

    resume_ad            
    bool   true  Resume/foreground ad

    ban_large             bool   true  Show
    MREC

    ad_loading            bool   false Show loading panel

    remove_ad_popup      
    bool   false Remove-ads popup

    remove_ad_level       int    7     Level to
    show popup

    rate_us               bool   true  Rate Us prompt

    rate_us_level        
    int    20    Level to show it

    CanUseMemoryCheck     bool   true  Memory
    guard enabled

    MinMemoryCheck        int    400   Min free MB to load ads'
  externalSDKs: "Google Mobile Ads (AdMob) \u2014 GoogleMobileAds, GoogleMobileAds.Core,\n                           
    GoogleMobileAds.Unity, GoogleMobileAds.Editor\nFirebase                  \u2014
    Firebase.App, Firebase.Analytics,\n                            Firebase.RemoteConfig,
    Firebase.TaskExtension\nAdjust                    \u2014 AdjustSdk\ncom.unity.ads
    is NOT used."
  upmPackages: 'com.unity.purchasing   5.1.2  IAP

    com.unity.inputsystem  1.18.0
    UI input

    com.unity.ugui         2.0.0  Unity UI

    com.unity.timeline    
    1.8.10 Timeline

    com.coplaydev.unity-mcp 9.7.3 MCP for Unity (tooling)'
